* text=auto

# Linux scripts must ALWAYS be LF so they run on Kali even when cloned on Windows.
*.sh       text eol=lf
*.py       text eol=lf
ctf-file   text eol=lf
ctf-eval   text eol=lf
install.sh text eol=lf

# Binary assets — never apply EOL conversion.
*.zip binary
*.png binary
*.bin binary
*.pdf binary
