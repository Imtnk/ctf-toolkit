#!/usr/bin/env python3
"""ctf-writeup — capture the current terminal session + the artifacts a solve left
behind, then have an AI author a CTF writeup. Saves everything into a <base>-work/
folder (same contract as ctf-eval).

Assumes the challenge is solved. If NO flag is found in the ground truth (session +
artifacts), the writeup still generates but ends with a "Suggested next steps"
section instead of a flag — a flag is NEVER invented.

Usage:
  ctf-writeup                         # session-wide: all *-work/ under cwd -> session-work/writeup.md
  ctf-writeup <file>                  # one challenge: reads <file>-work/, writes writeup.md there
  ctf-writeup http://10.10.10.10      # web target -> <host[_port]>-work/
  ctf-writeup <file> --log run.log    # use an explicit session log (or pipe on stdin)
  ctf-writeup <file> --no-session     # writeup from artifacts only (skip session capture)
  ctf-writeup <file> --style concise  # standard (default) | concise | report
  ctf-writeup <file> --local          # force local Ollama instead of the remote brain
  ctf-writeup <file> --fast           # local qwen2.5-coder (faster) — implies --local
  ctf-writeup <file> --offline        # no model — emit a template stub writeup
  ctf-writeup <file> -v               # stream the model's live output to stderr
  ctf-writeup --check                 # report the active brain (remote/local/offline) and exit
  ctf-writeup -h

Session capture (auto-detect ladder; robust choice first):
  1. --log FILE or piped stdin        — used verbatim.
  2. $CTF_SESSION_LOG / newest ~/.ctf-sessions/*.log — a `script` typescript (start a
     session with `ctf-rec`). Survives clear / exit / blocking commands like nc.
  3. $TMUX set                        — tmux capture-pane of the current pane
     (note: `clear` wipes tmux scrollback; a closed/blocked pane can't be captured).
  4. fallback                         — recent shell history + every *-work/commands.log,
     labelled as reconstructed (commands only, no interactive output).

Brain: the default author is the remote OpenAI-compatible gateway (CTF_REMOTE_MODEL)
when CTF_REMOTE_API_KEY is set and CTF_BRAIN != local; else the local Ollama model;
if that's unreachable it degrades to a deterministic offline stub. The key is read
from the env (sourced from ~/.config/ctf-toolchain/secrets.env) and never logged.

Outputs (in the -work/ dir):
  session.txt        the captured terminal session (ground truth)
  writeup.md         the generated writeup (the deliverable)
  writeup-trace.txt  raw model reply incl. reasoning
"""
import os, sys, re, glob, json, shutil, subprocess, urllib.request, urllib.error, urllib.parse
from datetime import datetime, timezone

VERSION = "1.0"

# ── Remote "brain" (OpenAI-compatible gateway) ────────────────────────────────
# ONE source of truth for the brain config: reuse agent/config.py when importable
# (ctf-writeup ships in the same repo, bin/ alongside agent/). Falls back to the same
# env vars if run detached from the package. Mirrors ctf-eval's shim.
_REPO_ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
if _REPO_ROOT not in sys.path:
    sys.path.insert(0, _REPO_ROOT)
try:
    from agent import config as _cfg
except Exception:
    _cfg = None

if _cfg is not None:
    REMOTE_MODEL      = _cfg.REMOTE_MODEL
    REMOTE_BASE       = _cfg.REMOTE_BASE_URL
    REMOTE_KEY        = _cfg.REMOTE_API_KEY
    REMOTE_TIMEOUT    = _cfg.REMOTE_TIMEOUT
    REMOTE_ENABLED    = _cfg.REMOTE_ENABLED
    REMOTE_MAX_TOKENS = _cfg.REMOTE_MAX_TOKENS
    REMOTE_UA         = _cfg.REMOTE_USER_AGENT
else:
    REMOTE_MODEL   = os.environ.get("CTF_REMOTE_MODEL", "qwen3.6-35b-a3b")
    REMOTE_BASE    = os.environ.get("CTF_REMOTE_BASE_URL", "https://gateway.9arm.co/v1").rstrip("/")
    REMOTE_KEY     = os.environ.get("CTF_REMOTE_API_KEY", "")
    REMOTE_TIMEOUT = int(os.environ.get("CTF_REMOTE_TIMEOUT", "300"))
    REMOTE_ENABLED = os.environ.get("CTF_BRAIN", "remote").lower() != "local"
    REMOTE_MAX_TOKENS = int(os.environ.get("CTF_REMOTE_MAX_TOKENS", "4096"))
    REMOTE_UA      = os.environ.get(
        "CTF_REMOTE_USER_AGENT",
        "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 "
        "(KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36")

# The writeup can need a lot of output tokens (prose is longer than a verdict) — give
# the remote brain a bigger default budget than ctf-eval unless the env overrides it.
if "CTF_REMOTE_MAX_TOKENS" not in os.environ:
    REMOTE_MAX_TOKENS = max(REMOTE_MAX_TOKENS, 6000)

# Local Ollama (fallback rung). Same host env var as ctf-eval / ai.py.
MAC_IP    = os.environ.get("CTF_AI_HOST", "192.168.1.11")
BASE_URL  = f"http://{MAC_IP}:11434"
CHAT_URL  = f"{BASE_URL}/api/chat"
DEEPSEEK  = "deepseek-r1:14b"
QWEN      = "qwen2.5-coder:14b"
KEEPALIVE = os.environ.get("CTF_EVAL_KEEPALIVE", "5m")
NUM_CTX   = 16384

# Input caps (chars). Remote model has a much larger window than the local one.
REMOTE_SESSION_CAP  = int(os.environ.get("CTF_WRITEUP_SESSION_CAP", "40000"))
LOCAL_SESSION_CAP   = 12000
REMOTE_REPORT_CAP   = int(os.environ.get("CTF_REMOTE_REPORT_CAP", "60000"))
REMOTE_ART_FILE_CAP, REMOTE_ART_TOTAL_CAP = 12000, 32000
LOCAL_ART_FILE_CAP,  LOCAL_ART_TOTAL_CAP  = 4000, 8000
HISTORY_LINES = int(os.environ.get("CTF_WRITEUP_HISTORY_LINES", "200"))

# flag-shaped token, e.g. flag{...} ctf{...} key{...}
FLAG_RE = re.compile(r"\b[A-Za-z0-9_]{2,12}\{[^}\r\n]{1,120}\}")
# ANSI/CSI escape sequences (typescripts are full of them)
ANSI_RE = re.compile(r"\x1b\[[0-9;?]*[ -/]*[@-~]|\x1b[()][A-Za-z0-9]|[\x00-\x08\x0b\x0c\x0e-\x1f]")

# ctf-writeup's OWN outputs — never scan them back in as artifacts.
OWN_OUTPUTS = {"writeup.md", "session.txt", "writeup-trace.txt"}
ARTIFACT_INLINE_SKIP = {"common.lst"}

_STYLE_TAIL = (
    "Write the report as clean GitHub-flavored Markdown. Start with an H1 title. "
    "Base every claim on the session log and artifacts you were given — they are GROUND "
    "TRUTH. NEVER invent a flag, a decode, a command output, or a step that is not "
    "supported by them. If a flag is present, quote it VERBATIM in a fenced code block. "
    "If NO flag is present, do not guess one: finish with a '## Suggested next steps' "
    "section listing 1-3 concrete next actions with exact commands. Do not fabricate "
    "reasoning you did not actually see evidence for."
)
SYSTEM = {
    "standard": (
        "You are a CTF player writing up a solved challenge for a public writeup repo. "
        "Produce a clear, competition-style writeup with these sections: a short "
        "**Summary** (challenge/category and the gist of the solve), **Recon** (what you "
        "observed), **Exploitation / Solution** (the concrete steps and commands that led "
        "to the flag), and **Flag**. " + _STYLE_TAIL),
    "concise": (
        "You are a CTF player jotting terse solve notes. Produce a SHORT bullet-form "
        "writeup: what the challenge was, the key steps/commands taken, and the flag. "
        "No long prose. " + _STYLE_TAIL),
    "report": (
        "You are a security consultant writing a professional finding report from a CTF "
        "solve. Sections: **Finding / Summary**, **Impact**, **Reproduction** (exact "
        "steps/commands), **Flag / Evidence**, and **Remediation** (how a real system "
        "would fix the underlying issue). " + _STYLE_TAIL),
}


def eprint(*a):
    print(*a, file=sys.stderr, flush=True)


def now_iso():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


# ---------------------------------------------------------------- target resolution
def is_web_target(target):
    return bool(re.match(r"https?://", target, re.I))


def web_name(url):
    """Sanitised host[_port] — matches ctf-web.target_name so work dirs agree."""
    p = urllib.parse.urlparse(url if "://" in url else "http://" + url)
    host = p.hostname or "target"
    name = host + (f"_{p.port}" if p.port else "")
    return re.sub(r"[^A-Za-z0-9._-]", "_", name)


# ---------------------------------------------------------------- session capture
def _clean(text):
    """Strip ANSI/control noise from a typescript or capture so the model sees clean text."""
    return ANSI_RE.sub("", text.replace("\r\n", "\n").replace("\r", "\n"))


def _read_file(path, cap):
    try:
        with open(path, "rb") as f:
            data = f.read()
    except OSError as e:
        return None, f"({path}: {e})"
    text = _clean(data.decode("utf-8", "replace"))
    if len(text) > cap:
        text = text[-cap:]      # keep the TAIL — the end of a session has the solve
        text = "…[earlier session truncated]\n" + text
    return text, None


def capture_session(explicit_log, no_session, cap, work_dirs):
    """Auto-detect ladder — see the module docstring. Returns (text, source_label)."""
    if no_session:
        return "", "skipped (--no-session)"

    # 1. explicit --log FILE, or content piped on stdin.
    if explicit_log:
        text, err = _read_file(explicit_log, cap)
        if text is None:
            eprint(f"[ctf-writeup] {err}")
            return "", f"log unreadable: {explicit_log}"
        return text, f"--log {explicit_log}"
    if not sys.stdin.isatty():
        piped = sys.stdin.read()
        if piped.strip():
            text = _clean(piped)
            return (text[-cap:] if len(text) > cap else text), "stdin (piped)"

    # 2. a `script` typescript (the robust source — ctf-rec sets CTF_SESSION_LOG).
    log = os.environ.get("CTF_SESSION_LOG", "")
    if not (log and os.path.isfile(log)):
        logs = sorted(glob.glob(os.path.expanduser("~/.ctf-sessions/*.log")),
                      key=lambda p: os.path.getmtime(p), reverse=True)
        log = logs[0] if logs else ""
    if log and os.path.isfile(log):
        text, err = _read_file(log, cap)
        if text is not None:
            return text, f"script typescript ({log})"

    # 3. tmux — capture the current pane's scrollback.
    if os.environ.get("TMUX"):
        try:
            pane = os.environ.get("TMUX_PANE", "")
            cmd = ["tmux", "capture-pane", "-p", "-S", "-"] + (["-t", pane] if pane else [])
            out = subprocess.run(cmd, capture_output=True, text=True, timeout=15).stdout
            if out.strip():
                text = _clean(out)
                return (text[-cap:] if len(text) > cap else text), "tmux capture-pane"
        except Exception as e:
            eprint(f"[ctf-writeup] tmux capture failed ({e})")

    # 4. fallback: recent shell history + every *-work/commands.log (reconstructed).
    parts = []
    for hist in ("~/.zsh_history", "~/.bash_history"):
        hp = os.path.expanduser(hist)
        if os.path.isfile(hp):
            text, _ = _read_file(hp, cap)
            if text:
                lines = text.splitlines()[-HISTORY_LINES:]
                # zsh EXTENDED_HISTORY prefixes ': <epoch>:0;cmd' — strip it.
                lines = [re.sub(r"^:\s*\d+:\d+;", "", ln) for ln in lines]
                parts.append(f"# recent {os.path.basename(hp)} (last {len(lines)} cmds)\n"
                             + "\n".join(lines))
            break
    for wd in work_dirs:
        clog = os.path.join(wd, "commands.log")
        if os.path.isfile(clog):
            text, _ = _read_file(clog, cap)
            if text:
                parts.append(f"# {wd}/commands.log\n{text}")
    if parts:
        body = ("[RECONSTRUCTED session — no live capture available; shell history + tool "
                "command logs only, interactive output not preserved]\n\n" + "\n\n".join(parts))
        return body[-cap:] if len(body) > cap else body, "reconstructed (history + commands.log)"

    return "", "unavailable"


# ---------------------------------------------------------------- Ollama (local rung)
def server_up(timeout=4):
    try:
        with urllib.request.urlopen(BASE_URL, timeout=timeout):
            return True
    except Exception:
        return False


def stream_chat(model, system, prompt, echo, think=True):
    """Stream a reply from local Ollama. Returns (answer, reasoning)."""
    def _run(with_think):
        body = {
            "model": model, "stream": True, "keep_alive": KEEPALIVE,
            "options": {"num_ctx": NUM_CTX, "temperature": 0.2},
            "messages": [{"role": "system", "content": system},
                         {"role": "user", "content": prompt}],
        }
        if with_think:
            body["think"] = True
        req = urllib.request.Request(CHAT_URL, data=json.dumps(body).encode(),
                                     headers={"Content-Type": "application/json"})
        ans, rsn = [], []
        with urllib.request.urlopen(req) as r:
            for line in r:
                line = line.strip()
                if not line:
                    continue
                try:
                    msg = json.loads(line).get("message", {})
                except json.JSONDecodeError:
                    continue
                t, c = msg.get("thinking", ""), msg.get("content", "")
                if t:
                    rsn.append(t)
                    if echo:
                        sys.stderr.write(f"\033[90m{t}\033[0m" if sys.stderr.isatty() else t)
                        sys.stderr.flush()
                if c:
                    ans.append(c)
                    if echo:
                        sys.stderr.write(c); sys.stderr.flush()
        if echo:
            sys.stderr.write("\n"); sys.stderr.flush()
        return "".join(ans), "".join(rsn)

    try:
        return _run(think)
    except urllib.error.HTTPError as e:
        if think and e.code == 400:
            return _run(False)
        raise


def remote_chat(system, prompt, echo=False):
    """OpenAI-compatible streaming chat against the remote gateway. Returns
    (content, reasoning). The API key is NEVER echoed."""
    messages = [{"role": "system", "content": system},
                {"role": "user", "content": prompt}]

    def _open(stream):
        body = json.dumps({
            "model": REMOTE_MODEL, "temperature": 0.2,
            "max_tokens": REMOTE_MAX_TOKENS, "stream": stream,
            "messages": messages,
        }).encode()
        req = urllib.request.Request(
            f"{REMOTE_BASE}/chat/completions", data=body,
            headers={"Content-Type": "application/json",
                     "Authorization": f"Bearer {REMOTE_KEY}",
                     "User-Agent": REMOTE_UA})
        return urllib.request.urlopen(req, timeout=REMOTE_TIMEOUT)

    def _stream():
        ans, rsn = [], []
        with _open(True) as r:
            for raw in r:
                line = raw.decode("utf-8", "replace").strip()
                if not line or not line.startswith("data:"):
                    continue
                d = line[5:].strip()
                if d == "[DONE]":
                    break
                try:
                    chunk = json.loads(d)
                except json.JSONDecodeError:
                    continue
                delta = (chunk.get("choices") or [{}])[0].get("delta", {}) or {}
                t = delta.get("reasoning_content") or ""
                c = delta.get("content") or ""
                if t:
                    rsn.append(t)
                    if echo:
                        sys.stderr.write(f"\033[90m{t}\033[0m" if sys.stderr.isatty() else t)
                        sys.stderr.flush()
                if c:
                    ans.append(c)
                    if echo:
                        sys.stderr.write(c); sys.stderr.flush()
            if echo:
                sys.stderr.write("\n"); sys.stderr.flush()
        return "".join(ans), "".join(rsn)

    def _nonstream():
        with _open(False) as r:
            data = json.load(r)
        msg = data["choices"][0]["message"]
        return msg.get("content", "") or "", msg.get("reasoning_content", "") or ""

    try:
        return _stream()
    except urllib.error.HTTPError as e:
        if e.code in (400, 404, 405):
            return _nonstream()
        detail = ""
        try:
            detail = e.read().decode("utf-8", "replace")[:300]
        except Exception:
            pass
        raise RuntimeError(f"HTTP {e.code}: {detail}") from None
    except urllib.error.URLError as e:
        raise RuntimeError(f"unreachable ({REMOTE_BASE}): {e.reason}") from None


def split_think(raw):
    """Separate a <think>...</think> block from the final answer (some models inline it)."""
    m = re.search(r"<think>(.*?)</think>", raw, re.DOTALL)
    if m:
        return (raw[:m.start()] + raw[m.end():]).strip(), raw
    if "<think>" in raw:
        return raw.split("<think>", 1)[0].strip() or raw, raw
    return raw.strip(), raw


# ---------------------------------------------------------------- artifacts
def _looks_text(chunk):
    if b"\x00" in chunk:
        return False
    try:
        chunk.decode("utf-8")
    except UnicodeDecodeError:
        try:
            chunk[:-3].decode("utf-8")
        except UnicodeDecodeError:
            return False
    return True


def scan_artifacts(work, prefix, file_cap, total_cap, budget):
    """Walk one <base>-work/ folder generically (copied from ctf-eval).

    `prefix` labels manifest paths (e.g. the work-dir name) so a merged multi-dir
    manifest is unambiguous. `budget` is a mutable [remaining] total-inline counter
    shared across dirs so the whole prompt stays bounded. Returns (manifest,
    inlined_text, art_flags)."""
    manifest, art_flags, seen = [], [], set()
    inl_parts = []
    if not os.path.isdir(work):
        return manifest, "", art_flags
    for root, dirs, files in os.walk(work):
        dirs.sort()
        for name in sorted(files):
            full = os.path.join(root, name)
            rel = os.path.relpath(full, work).replace(os.sep, "/")
            if rel in OWN_OUTPUTS:
                continue
            label = f"{prefix}/{rel}" if prefix else rel
            try:
                size = os.path.getsize(full)
                with open(full, "rb") as f:
                    chunk = f.read(file_cap * 4 + 8)
            except OSError:
                manifest.append({"path": label, "size": -1, "kind": "unreadable"})
                continue
            text = _looks_text(chunk)
            manifest.append({"path": label, "size": size, "kind": "text" if text else "binary"})
            if not text:
                continue
            s = chunk.decode("utf-8", "replace")
            for m in FLAG_RE.findall(s):
                if m not in seen:
                    seen.add(m); art_flags.append(m)
            if name in ARTIFACT_INLINE_SKIP or budget[0] <= 0:
                continue
            body = s[:min(file_cap, budget[0])]
            if len(s) > len(body) or size > len(chunk):
                body += "\n…[truncated]"
            block = f"--- {label} ({size} bytes) ---\n{body}"
            inl_parts.append(block); budget[0] -= len(block)
    return manifest, "\n\n".join(inl_parts), art_flags


def gather_artifacts(work_dirs, multi, file_cap, total_cap):
    """Scan one or many work dirs, merging manifests/inlined text/flags."""
    budget = [total_cap]
    manifest, inl, flags = [], [], []
    for wd in work_dirs:
        prefix = os.path.basename(wd.rstrip("/")) if multi else ""
        m, text, fl = scan_artifacts(wd, prefix, file_cap, total_cap, budget)
        manifest += m
        if text:
            inl.append(text)
        for f in fl:
            if f not in flags:
                flags.append(f)
    return manifest, "\n\n".join(inl), flags


def find_flags(*texts):
    seen, out = set(), []
    for t in texts:
        for m in FLAG_RE.findall(t or ""):
            if m not in seen:
                seen.add(m); out.append(m)
    return out


# ---------------------------------------------------------------- prompt / stub
def build_prompt(label, session_text, session_src, manifest, artifact_text, flags):
    art_list = "\n".join(f"  {m['path']}  ({m['size']} B, {m['kind']})"
                         for m in manifest) or "  (none)"
    p = [f"Write a CTF writeup for: {label}\n"]
    if flags:
        p.append("Flag(s) found in the ground truth (quote verbatim, do not alter):\n"
                 + "\n".join(f"  {f}" for f in flags) + "\n")
    else:
        p.append("No flag was found in the session or artifacts — do NOT invent one; "
                 "end with concrete next steps.\n")
    p.append(f"--- BEGIN TERMINAL SESSION (source: {session_src}) ---\n"
             f"{session_text or '(no session captured)'}\n--- END TERMINAL SESSION ---\n")
    p.append(f"Artifacts on disk:\n{art_list}")
    if artifact_text:
        p.append("\n--- BEGIN ARTIFACT CONTENTS ---\n"
                 f"{artifact_text}\n--- END ARTIFACT CONTENTS ---")
    return "\n".join(p)


def stub_writeup(label, style, session_text, session_src, manifest, flags):
    """Deterministic offline writeup — used when no model is reachable/requested."""
    L = [f"# Writeup — {label}", ""]
    L.append("> Generated offline (no model). Fill in the analysis; the raw session and "
             "artifacts below are ground truth.\n")
    if flags:
        L += ["## Flag", "", "```", *flags, "```", ""]
    else:
        L += ["## Suggested next steps", "",
              "- No flag was captured. Review the session and artifacts below and continue "
              "the solve.", ""]
    L += [f"## Terminal session", f"", f"_source: {session_src}_", "", "```",
          (session_text or "(no session captured)"), "```", ""]
    arts = "\n".join(f"- `{m['path']}` ({m['size']} B, {m['kind']})" for m in manifest) or "- (none)"
    L += ["## Artifacts", "", arts, ""]
    return "\n".join(L)


def flag_sanity_note(writeup_md, corpus):
    """If the writeup quotes a flag absent from ground truth, append an editor's warning
    rather than silently trusting it (the prose guardrail is best-effort)."""
    claimed = find_flags(writeup_md)
    bogus = [f for f in claimed if f not in corpus]
    if bogus:
        return (writeup_md.rstrip() + "\n\n> ⚠️ ctf-writeup: the flag(s) "
                + ", ".join(f"`{b}`" for b in bogus)
                + " were NOT found in the captured session or artifacts — verify before "
                  "trusting them (possible hallucination).\n")
    return writeup_md


# ---------------------------------------------------------------- output
def write_outputs(out_dir, session_text, writeup_md, reasoning, content):
    os.makedirs(out_dir, exist_ok=True)
    session_path = os.path.join(out_dir, "session.txt")
    writeup_path = os.path.join(out_dir, "writeup.md")
    trace_path   = os.path.join(out_dir, "writeup-trace.txt")
    with open(session_path, "w", encoding="utf-8", errors="replace") as f:
        f.write(session_text or "")
    with open(writeup_path, "w", encoding="utf-8", errors="replace") as f:
        f.write(writeup_md.rstrip() + "\n")
    if content is not None:
        with open(trace_path, "w", encoding="utf-8", errors="replace") as f:
            if (reasoning or "").strip():
                f.write("=== REASONING (model thinking) ===\n" + reasoning.strip() + "\n\n")
            f.write("=== ANSWER (writeup) ===\n" + content.strip() + "\n")
    return writeup_path


# ---------------------------------------------------------------- brain check
def run_check():
    """`--check`: report which brain is active on this box (remote / local / offline)
    and validate the key with one tiny gateway call. No challenge needed."""
    print("=== ctf-writeup brain check ===")
    print(f"  remote enabled : {REMOTE_ENABLED}  (CTF_BRAIN={'local' if not REMOTE_ENABLED else 'remote'})")
    print(f"  remote key     : {'set' if REMOTE_KEY else 'MISSING'}")
    print(f"  remote model   : {REMOTE_MODEL}")
    print(f"  remote base    : {REMOTE_BASE}")
    active = None
    if REMOTE_KEY and REMOTE_ENABLED:
        try:
            content, _ = remote_chat("You are a health check.", "Reply with the single word OK.")
            print(f"  remote ping    : OK — replied {content.strip()[:30]!r}")
            active = "remote"
        except Exception as e:
            print(f"  remote ping    : FAILED ({e})")
    elif not REMOTE_KEY:
        print("  remote ping    : skipped — no CTF_REMOTE_API_KEY "
              "(add one to ~/.config/ctf-toolchain/secrets.env)")
    up = server_up()
    print(f"  local ollama   : {'reachable' if up else 'unreachable'} at {MAC_IP}:11434")
    if active is None:
        active = "local" if up else "offline (stub only — no AI)"
    print(f"  => active brain: {active}")
    sys.exit(0)


# ---------------------------------------------------------------- main
def parse_args(argv):
    model, style = DEEPSEEK, "standard"
    offline = local = verbose = no_session = False
    explicit_log = None
    target = None
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("-h", "--help"):
            print(__doc__); sys.exit(0)
        elif a in ("-v", "--verbose"):
            verbose = True
        elif a == "--no-session":
            no_session = True
        elif a == "--offline":
            offline = True
        elif a == "--local":
            local = True
        elif a == "--fast":
            model = QWEN; local = True
        elif a in ("--log", "--session"):
            i += 1
            if i >= len(argv):
                eprint("[ctf-writeup] --log needs a file"); sys.exit(1)
            explicit_log = argv[i]
        elif a.startswith("--log="):
            explicit_log = a.split("=", 1)[1]
        elif a == "--style":
            i += 1
            if i >= len(argv) or argv[i] not in SYSTEM:
                eprint(f"[ctf-writeup] --style must be one of: {', '.join(SYSTEM)}"); sys.exit(1)
            style = argv[i]
        elif a.startswith("--style="):
            style = a.split("=", 1)[1]
            if style not in SYSTEM:
                eprint(f"[ctf-writeup] --style must be one of: {', '.join(SYSTEM)}"); sys.exit(1)
        elif a == "--model":
            i += 1
            if i >= len(argv):
                eprint("[ctf-writeup] --model needs a value"); sys.exit(1)
            model = argv[i]; local = True
        elif a.startswith("--model="):
            model = a.split("=", 1)[1]; local = True
        elif a.startswith("-"):
            eprint(f"[ctf-writeup] unknown option {a}"); sys.exit(1)
        elif target is None:
            target = a
        else:
            eprint(f"[ctf-writeup] unexpected arg {a}"); sys.exit(1)
        i += 1
    return target, model, style, offline, local, verbose, no_session, explicit_log


def resolve_scope(target):
    """Return (label, out_dir, work_dirs, multi). One target -> its <base>-work/;
    no target -> all *-work/ in cwd merged into session-work/."""
    if target:
        base = web_name(target) if is_web_target(target) else os.path.basename(target)
        out_dir = f"{base}-work"
        work_dirs = [out_dir] if os.path.isdir(out_dir) else []
        if not work_dirs:
            eprint(f"[ctf-writeup] no {out_dir}/ found — writeup will be session-only")
        return target, out_dir, work_dirs, False
    out_dir = "session-work"
    work_dirs = sorted(d for d in glob.glob("*-work")
                       if os.path.isdir(d) and os.path.abspath(d) != os.path.abspath(out_dir))
    if not work_dirs:
        eprint("[ctf-writeup] no *-work/ dirs in cwd — writeup will be session-only")
    label = f"session in {os.path.basename(os.getcwd())} ({len(work_dirs)} work dir(s))"
    return label, out_dir, work_dirs, True


def main():
    if "--check" in sys.argv[1:]:
        run_check()
    (target, model, style, offline, local, verbose,
     no_session, explicit_log) = parse_args(sys.argv[1:])

    label, out_dir, work_dirs, multi = resolve_scope(target)

    use_remote = REMOTE_ENABLED and bool(REMOTE_KEY) and not local and not offline
    if not offline and not local and not REMOTE_KEY:
        eprint("[ctf-writeup] no CTF_REMOTE_API_KEY set — the AI brain is off; using "
               "local/offline. Add a key to ~/.config/ctf-toolchain/secrets.env "
               "(and `source ~/.bashrc`) to enable the AI writeup.")
    session_cap = REMOTE_SESSION_CAP if use_remote else LOCAL_SESSION_CAP
    art_file_cap  = REMOTE_ART_FILE_CAP  if use_remote else LOCAL_ART_FILE_CAP
    art_total_cap = REMOTE_ART_TOTAL_CAP if use_remote else LOCAL_ART_TOTAL_CAP

    # Capture the session (into out_dir/session.txt via write_outputs later).
    session_text, session_src = capture_session(explicit_log, no_session, session_cap, work_dirs)
    eprint(f"[ctf-writeup] session: {session_src} ({len(session_text)} chars)")

    # Gather artifacts from the work dir(s).
    manifest, artifact_text, art_flags = gather_artifacts(work_dirs, multi, art_file_cap, art_total_cap)
    flags = find_flags(session_text) + [f for f in art_flags if f not in find_flags(session_text)]
    corpus = (session_text or "") + "\n" + (artifact_text or "")
    n_art = len([m for m in manifest if m["kind"] != "unreadable"])
    eprint(f"[ctf-writeup] {n_art} artifact file(s)"
           + (f", {len(flags)} flag(s) found" if flags else ", no flag found"))

    prompt = build_prompt(label, session_text, session_src, manifest, artifact_text, flags)
    echo = verbose
    reasoning = content = None
    used = ""

    def _finish(md, used_model):
        md = flag_sanity_note(md, corpus)
        path = write_outputs(out_dir, session_text, md, reasoning or "", content)
        paid = use_remote and REMOTE_MODEL in used_model
        C = sys.stdout.isatty()
        def c(code, s): return f"\033[{code}m{s}\033[0m" if C else s
        print(c("36;1", "=== WRITEUP ===") if C else "=== WRITEUP ===")
        print(f"  brain   : {used_model}  ({c('33','remote · paid') if paid else c('32','local/offline · free')})")
        print(f"  style   : {style}")
        print(f"  flag(s) : {c('32;1', ', '.join(flags)) if flags else c('90','none — ends with next steps')}")
        print(f"  writeup : {path}")
        sys.exit(0)

    if offline:
        eprint("[ctf-writeup] offline stub (requested)")
        _finish(stub_writeup(label, style, session_text, session_src, manifest, flags), "offline-stub")

    def _try_remote():
        nonlocal reasoning, content
        eprint(f"[ctf-writeup] asking remote brain {REMOTE_MODEL} ({REMOTE_BASE}) ...")
        raw, reasoning = remote_chat(SYSTEM[style], prompt, echo=echo)
        content = raw
        md, _ = split_think(raw)
        return md

    def _try_local():
        nonlocal reasoning, content
        eprint(f"[ctf-writeup] asking {model} (keep_alive={KEEPALIVE}) ...")
        raw, reasoning = stream_chat(model, SYSTEM[style], prompt, echo)
        content = raw
        md, _ = split_think(raw)
        return md

    if use_remote:
        try:
            _finish(_try_remote(), REMOTE_MODEL)
        except Exception as e:
            eprint(f"[ctf-writeup] remote brain failed ({e})")
            if server_up():
                try:
                    _finish(_try_local(), model)
                except Exception as e2:
                    eprint(f"[ctf-writeup] local model failed ({e2}) — offline stub")
            else:
                eprint(f"[ctf-writeup] {MAC_IP}:11434 unreachable — offline stub")
            _finish(stub_writeup(label, style, session_text, session_src, manifest, flags),
                    "offline-stub")
    elif not server_up():
        eprint(f"[ctf-writeup] {MAC_IP}:11434 unreachable — offline stub")
        _finish(stub_writeup(label, style, session_text, session_src, manifest, flags), "offline-stub")
    else:
        try:
            _finish(_try_local(), model)
        except Exception as e:
            eprint(f"[ctf-writeup] model call failed ({e}) — offline stub")
            _finish(stub_writeup(label, style, session_text, session_src, manifest, flags),
                    "offline-stub")


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        eprint("\n[ctf-writeup] interrupted")
        sys.exit(130)
